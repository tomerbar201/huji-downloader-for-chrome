{
  "manifest_version": 3,
  "name": "HUJI Moodle Downloader",
  "version": "1.0.0",
  "description": "Download all course materials from HUJI Moodle (5.0.7) with one click. Automatically organizes files into folders by section.",
  "default_locale": "en",
  "icons": {
    "16": "assets/icon-16.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "assets/icon-16.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png"
    },
    "default_title": "HUJI Moodle Downloader"
  },
  "background": {
    "service_worker": "src/background/service_worker.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "downloads",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "*://moodle.huji.ac.il/*",
    "*://moodle4.cs.huji.ac.il/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "minimum_chrome_version": "110"
}
